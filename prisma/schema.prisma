// Inventory Manager — database schema.
//
// Design rules applied throughout:
//   * Every relationship is a real foreign key. Ownership decides the delete
//     behaviour: line items are Cascade (they cannot outlive their document),
//     anything a document points at is Restrict (a product with history cannot
//     be deleted out from under it), and optional lookups are SetNull.
//   * Money is Decimal(12, 2). Never Float — binary floating point cannot hold
//     0.10 exactly and totals drift once you add enough of them.
//   * Every table carries timestamps, and every column that gets filtered or
//     sorted on carries an index.
//
// The one invariant worth stating up front: Product.stockQuantity is the single
// source of truth for stock on hand, and every change to it must be written
// alongside a StockTransaction row in the same transaction. StockTransaction is
// the audit log that explains how a quantity came to be what it is.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Application roles. ADMIN can do everything; STAFF works the day-to-day
/// screens but cannot manage users or delete records.
enum UserRole {
  ADMIN
  STAFF
}

/// Whether a catalogue item can be sold. DISCONTINUED is kept distinct from
/// INACTIVE so a temporary pause reads differently from a permanent one.
enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

/// Sales order lifecycle. Stock leaves the building on CONFIRMED, which is the
/// point the stock engine deducts it.
enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

/// Purchase order lifecycle. Stock arrives on RECEIVED, which is the point the
/// stock engine adds it.
enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

/// Why a quantity changed. STOCK_IN and STOCK_OUT are the ordinary inbound and
/// outbound moves, ADJUSTMENT is a manual correction (a stock count, breakage),
/// and REVERSAL undoes an earlier transaction rather than deleting it — the
/// ledger is append-only.
enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  REVERSAL
}

/// What a stock transaction points at. This pair (referenceType, referenceId)
/// is deliberately polymorphic — it can address an order, a purchase, another
/// transaction, or nothing at all — so the database cannot enforce it as a
/// foreign key. The enum at least keeps the type side honest, and MANUAL marks
/// the rows that legitimately have no reference.
enum StockReferenceType {
  ORDER
  PURCHASE
  STOCK_TRANSACTION
  MANUAL
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

/// An operator of the system.
///
/// Clerk owns authentication — the password, MFA, the session — and this row
/// owns the local business identity: what the person is allowed to do here, and
/// something for foreign keys to point at. There is deliberately no password
/// column; if one existed it would be a second, unused credential store.
///
/// `clerkId` is the join between the two and the only stable identity key.
/// Email is *not* usable for that: it is unique here, but a user can change it
/// in Clerk at any time, which would silently strand the mapping.
model User {
  id String @id @default(cuid())

  /// Clerk's user id (`user_...`). Rows created before their Clerk account
  /// exists — the seed's, for instance — carry an `unlinked_` placeholder
  /// instead, which the first sign-in with a matching email claims. See
  /// `resolveUser` in src/server/auth.ts.
  clerkId String @unique @map("clerk_id")

  name  String
  email String @unique

  /// Authorisation lives here, not in Clerk. Clerk answers "who is this?";
  /// this column answers "what may they do in the inventory app?".
  role UserRole @default(STAFF)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockTransactions StockTransaction[]
  certificates      Certificate[]

  @@index([role])
  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([name])
  @@map("customers")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?  @unique
  address       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products  Product[]
  purchases Purchase[]

  @@index([name])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Product {
  id          String  @id @default(cuid())
  name        String
  sku         String  @unique
  description String?

  /// A plain label rather than a lookup table: categories here are a filter in
  /// the UI, not something that owns behaviour or rows of its own.
  category String

  /// What we pay for one unit.
  costPrice Decimal @map("cost_price") @db.Decimal(12, 2)

  /// What we sell one unit for.
  sellingPrice Decimal @map("selling_price") @db.Decimal(12, 2)

  /// Stock on hand. Never write this directly — go through the stock engine so
  /// a StockTransaction is recorded in the same database transaction.
  stockQuantity Int @default(0) @map("stock_quantity")

  /// At or below this level the product counts as low stock. The derived
  /// status is never stored, so it cannot drift from the quantity it describes.
  minimumStock Int @default(0) @map("minimum_stock")

  status    ProductStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  /// Optional: a product can exist before its supplier is known, and removing
  /// a supplier must not remove the catalogue items bought from them.
  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  orderItems        OrderItem[]
  purchaseItems     PurchaseItem[]
  stockTransactions StockTransaction[]
  certificates      Certificate[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([supplierId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")
  status      OrderStatus @default(DRAFT)

  /// Sum of the line totals, then the one adjustment applied to it.
  /// Denormalised so lists and reports do not aggregate items on every read;
  /// recalculated whenever the items change.
  ///
  /// total = subtotal - discount. There is deliberately no tax column: this
  /// system does not compute tax, and a column defaulting to zero would be an
  /// invitation to start — the grand total is the discounted subtotal and
  /// nothing else. The check constraint in the migration enforces it.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Required: an order without a customer is not a state this app has a use
  /// for. Restrict, so a customer with history cannot be deleted — deactivate
  /// them instead.
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  items OrderItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  quantity Int

  /// Copied from the product at the time of sale — an order must not change
  /// retrospectively when someone edits the price list.
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One line per product per order. Two lines for the same product are an
  /// editing mistake, not a scenario — the quantity belongs on one line.
  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique @map("purchase_number")
  status         PurchaseStatus @default(DRAFT)

  total Decimal @default(0) @db.Decimal(12, 2)

  /// When the order was placed with the supplier, which is not necessarily
  /// when the row was created.
  purchaseDate DateTime @default(now()) @map("purchase_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  items PurchaseItem[]

  @@index([status])
  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id String @id @default(cuid())

  quantity Int

  /// Copied from the product at the time of purchase, for the same reason
  /// OrderItem copies the price.
  unitCost Decimal @map("unit_cost") @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  purchaseId String   @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([purchaseId, productId])
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ---------------------------------------------------------------------------
// Stock ledger
// ---------------------------------------------------------------------------

/// One row per change to a product quantity — the audit trail behind every
/// stock adjustment. `quantity` is the absolute size of the move; the direction
/// is carried by `type`. `previousStock` and `newStock` record both sides of
/// the change, so a historical balance can be read back without replaying the
/// whole ledger, and a broken chain is visible at a glance.
///
/// The table is append-only: a mistake is corrected with a REVERSAL row that
/// references the transaction it undoes, never by editing or deleting history.
model StockTransaction {
  id            String               @id @default(cuid())
  type          StockTransactionType
  quantity      Int
  previousStock Int                  @map("previous_stock")
  newStock      Int                  @map("new_stock")

  /// Polymorphic pointer at whatever caused the move. Not a foreign key — see
  /// StockReferenceType. `referenceId` is null exactly when the type is MANUAL.
  referenceType StockReferenceType @default(MANUAL) @map("reference_type")
  referenceId   String?            @map("reference_id")

  /// Why the move happened, in the operator's words. Mandatory for a manual
  /// ADJUSTMENT — a correction with no stated reason is the one entry in this
  /// ledger nobody can audit — and left null for movements a document already
  /// explains. The requirement is enforced in `recordStockMovement` rather than
  /// as a check constraint, so the message can name the field.
  note String?

  createdAt DateTime @default(now()) @map("created_at")

  /// Restrict: a product that has moved stock has history, and history is not
  /// something a delete should take with it. Retire the product instead.
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Who triggered it. Null for system-generated rows such as the seed, and
  /// nulled rather than cascaded if the user is later removed — the movement
  /// still happened.
  createdBy     String? @map("created_by")
  createdByUser User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("stock_transactions")
}

// ---------------------------------------------------------------------------
// Certificates
// ---------------------------------------------------------------------------

/// Airworthiness and conformity paperwork for a part.
///
/// In an aviation parts business the certificate is not decoration — an
/// uncertified part is unsellable, and "which document, issued when, by whom"
/// is a question an auditor asks years later. The table is therefore shaped as
/// a record of documents over time rather than a column on Product.
///
/// A product has at most one *current* certificate and any number of retired
/// ones. `supersededAt` is what separates them: null means current, set means
/// replaced or withdrawn. Nothing is ever overwritten or deleted in the normal
/// course of events — replacing a certificate retires the old row and inserts a
/// new one, so the history reads as a sequence and the file each version
/// pointed at is still there.
///
/// "At most one current" is enforced by a partial unique index on
/// (product_id) WHERE superseded_at IS NULL, which Prisma's schema language
/// cannot express — it lives in the migration SQL alongside the check
/// constraints. Without it two concurrent uploads would both retire the old
/// certificate and both insert a new one, leaving a product with two current
/// certificates and no way to say which is authoritative.
model Certificate {
  id String @id @default(cuid())

  /// A plain label rather than an enum, for the same reason Product.category
  /// is: the set is open. FAA 8130-3, EASA Form 1, a Certificate of
  /// Conformity and an Airworthiness Certificate are the common ones, but a
  /// part sourced under a different authority — Transport Canada, CAAC, a
  /// manufacturer's own form — must not need a migration to record.
  certificateType String @map("certificate_type")

  /// The number printed on the document. Not unique: two authorities can
  /// legitimately issue the same number, and a reissued document often keeps
  /// the number it had.
  certificateNumber String @map("certificate_number")

  /// Dates, not timestamps — a certificate is issued on a day, not at an
  /// instant, and storing a time would invent a precision the paper does not
  /// have and drag timezone conversion into every comparison.
  issueDate DateTime @map("issue_date") @db.Date

  /// Nullable, and genuinely so. A Certificate of Conformity typically never
  /// expires; an airworthiness release usually does. Code that assumes an
  /// expiry date exists is wrong about half the documents in this table.
  expiryDate DateTime? @map("expiry_date") @db.Date

  /// The name the file had when it was uploaded. Shown to people, and used for
  /// nothing else — never to build a path, never to decide a content type.
  fileName String @map("file_name")

  /// Where the bytes actually live, as an opaque key the storage layer
  /// understands. Not a URL: a URL bakes in one provider and, worse, tends to
  /// become a public one. Certificates are served through an authenticated
  /// route that resolves this key server-side, so the location is never
  /// something a browser can guess or share.
  storageKey String @map("storage_key")

  /// Determined by inspecting the file's leading bytes on upload, not taken
  /// from the browser's claim. It is what the download route sends back, so a
  /// wrong value here would be a way to have a file served as something it is
  /// not.
  contentType String @map("content_type")

  /// Bytes. Displayed, and checked against the stored object as a cheap
  /// integrity signal.
  fileSize Int @map("file_size")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Null while this is the product's current certificate; set when it is
  /// replaced or withdrawn. This is the whole history mechanism.
  supersededAt DateTime? @map("superseded_at")

  /// Cascade, unlike most relations here. A certificate describes exactly one
  /// product and has no meaning without it, so it cannot outlive it — and the
  /// only products that can be deleted are ones that never traded. The stored
  /// file is removed explicitly by `deleteProduct`, because a foreign key
  /// cannot reach into a filesystem or a bucket.
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Who uploaded it, resolved from the Clerk session on the server. Nulled
  /// rather than cascaded if the user is later removed — the upload still
  /// happened.
  uploadedBy     String? @map("uploaded_by")
  uploadedByUser User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, supersededAt])
  @@index([expiryDate])
  @@index([certificateType])
  @@index([uploadedBy])
  @@map("certificates")
}
