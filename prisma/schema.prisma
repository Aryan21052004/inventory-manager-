// Inventory Manager — database schema.
//
// Design rules applied throughout:
//   * Every relationship is a real foreign key. Ownership decides the delete
//     behaviour: line items are Cascade (they cannot outlive their document),
//     anything a document points at is Restrict (a product with history cannot
//     be deleted out from under it), and optional lookups are SetNull.
//   * Money is Decimal(12, 2). Never Float — binary floating point cannot hold
//     0.10 exactly and totals drift once you add enough of them.
//   * Every table carries timestamps, and every column that gets filtered or
//     sorted on carries an index.
//
// The one invariant worth stating up front: Product.stockQuantity is the single
// source of truth for stock on hand, and every change to it must be written
// alongside a StockTransaction row in the same transaction. StockTransaction is
// the audit log that explains how a quantity came to be what it is.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Application roles. ADMIN can do everything; STAFF works the day-to-day
/// screens but cannot manage users or delete records.
enum UserRole {
  ADMIN
  STAFF
}

/// The currency the whole installation accounts in, as an ISO 4217 code.
///
/// Codes and not symbols: `₹` is a rendering of INR rather than the currency,
/// and `$` belongs to several currencies at once. The code is what this column
/// stores, what the formatter keys on, and what an exported report states.
///
/// All three have a two-decimal minor unit, which the costing engine relies on
/// — every amount is computed in integer minor units and stored as
/// `Decimal(12, 2)`. A currency with a different exponent (JPY has 0, KWD has
/// 3) cannot simply be added to this list; it would mis-scale every stored
/// amount with nothing to catch it.
enum Currency {
  USD
  INR
  EUR
}

/// Whether a catalogue item can be sold. DISCONTINUED is kept distinct from
/// INACTIVE so a temporary pause reads differently from a permanent one.
enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

/// Whether a customer is still traded with. There is no third state on
/// purpose: unlike a catalogue item, which can be paused or retired for
/// distinct reasons, a customer is either someone new orders may be raised for
/// or someone whose record is kept only for the history attached to it.
///
/// This is what `Order.customerId`'s Restrict deletion rule assumes exists — a
/// customer with orders can never be deleted, so there has to be a way to take
/// them out of circulation without destroying what they bought.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

/// Whether a supplier is still traded with. Two states for the same reason
/// CustomerStatus has two: a supplier is either somebody new business may be
/// placed with, or somebody whose record is kept for the history attached to
/// it.
///
/// Archiving is the normal end of a supplier relationship, and deletion is
/// reserved for a record created by mistake that nothing references. That is
/// not a stylistic preference here — `Purchase.supplierId` is `Restrict`, so a
/// supplier with any purchase cannot be deleted at all, and deleting one with
/// products would fire `SetNull` and silently blank the sourcing on every
/// catalogue row they supplied.
enum SupplierStatus {
  ACTIVE
  INACTIVE
}

/// Sales order lifecycle.
///
/// CONFIRMED is the only status that moves stock: it is the point the goods are
/// committed and the engine deducts them. DRAFT and PENDING are both "not yet
/// committed" — a draft is still being edited, a pending order is finished but
/// waiting on something (approval, payment) — and neither touches inventory.
/// COMPLETED means the goods have shipped; the stock left on CONFIRMED and is
/// not deducted a second time. CANCELLED returns whatever was deducted, once.
enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Purchase order lifecycle.
///
/// RECEIVED is the only status that moves stock: it is the point the goods are
/// physically in and the engine adds them. DRAFT and PENDING are both "not yet
/// arrived" — a draft is still being written, a pending purchase has been
/// placed with the supplier and is in transit — and neither touches inventory.
/// CANCELLED takes back whatever was added, once.
enum PurchaseStatus {
  DRAFT
  PENDING
  RECEIVED
  CANCELLED
}

/// Why a quantity changed. STOCK_IN and STOCK_OUT are the ordinary inbound and
/// outbound moves, ADJUSTMENT is a manual correction (a stock count, breakage),
/// and REVERSAL undoes an earlier transaction rather than deleting it — the
/// ledger is append-only.
enum StockTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  REVERSAL
}

/// What a stock transaction points at. This pair (referenceType, referenceId)
/// is deliberately polymorphic — it can address an order, a purchase, another
/// transaction, or nothing at all — so the database cannot enforce it as a
/// foreign key. The enum at least keeps the type side honest, and MANUAL marks
/// the rows that legitimately have no reference.
enum StockReferenceType {
  ORDER
  PURCHASE
  STOCK_TRANSACTION
  /// Goods a customer sent back, pointing at the Return that received them.
  ///
  /// Deliberately distinct from ORDER even though a return always concerns one.
  /// `cancelOrder` gathers a document's movements with
  /// `referenceType = 'ORDER' AND referenceId = orderId` and nets them to decide
  /// what to restore; a return carrying that reference would be swept into that
  /// netting and mis-restore the lots. Separating the reference makes the two
  /// documents' movements disjoint by construction rather than by remembering.
  ///
  /// The movement type stays STOCK_IN — the units genuinely arrive. A
  /// cancellation is REVERSAL against ORDER, so the two differ in both columns
  /// and no new StockTransactionType was needed for either.
  SALES_RETURN
  MANUAL
}

/// Where a lot's unit cost came from, which is a different question from
/// whether there is one. PURCHASE is the case that matters — a supplier
/// invoice line, the only cost this system treats as proven. OPENING and
/// ADJUSTMENT are costs an operator asserted for stock that arrived without a
/// purchase behind it, and either may legitimately have no cost at all.
///
/// UNKNOWN is the honest answer, not a failure: stock that predates lot
/// tracking, or whose paperwork cannot be reconstructed. Such a lot carries a
/// null cost and stays null. Nothing in this system is permitted to fill it in
/// from a catalogue figure or an average — a guessed cost is indistinguishable
/// from a real one once written, and that is precisely the confusion the whole
/// costing layer exists to prevent.
enum LotCostSource {
  PURCHASE
  OPENING
  ADJUSTMENT
  /// Units a customer sent back, re-entering stock at the cost they left at.
  ///
  /// Costed by construction, and never by a fresh judgement: the rate is copied
  /// from the `StockLotConsumption` row being reversed, which froze it when the
  /// units were drawn. A return whose original draw was uncosted produces an
  /// UNKNOWN lot instead — unknown stays unknown, in both directions.
  ///
  /// A return spanning several source lots produces several RETURN lots, one
  /// per cost layer. Averaging them would invent a rate no unit ever had.
  RETURN
  UNKNOWN
}

/// Whether a batch may be sold.
///
/// Lot-level rather than product-level, because it has to be: the same part
/// routinely holds saleable stock beside a returned batch awaiting inspection,
/// and a product-level flag would have to lie about one of them.
///
/// **Status never changes a quantity.** A quarantined lot's units are on the
/// shelf, inside `Product.stockQuantity`, and inside the invariant
/// `SUM(quantityRemaining) = stockQuantity`. What status decides is whether
/// FIFO may draw them, which is why saleable stock is derived from this column
/// rather than stored as a rival total.
///
/// There is no duration, no expiry and no scheduled transition. Different parts
/// warrant different inspections, so nothing here computes when quarantine
/// ends — a lot leaves QUARANTINED only when a person says so, and says why.
enum LotStatus {
  /// Ordinary stock. Every lot that is not a customer return is born here.
  SALEABLE

  /// Received back from a customer and not yet inspected. Excluded from FIFO.
  QUARANTINED

  /// Failed inspection. Still physically present and still carrying its cost —
  /// marking a lot rejected is a judgement, not a disposal, and value leaves
  /// only when the units do. Excluded from FIFO, and removable only by a
  /// targeted write-off against this specific lot: a normal decrease would go
  /// through FIFO, which skips this lot and would consume saleable stock in its
  /// place while the rejected units stayed on the books.
  REJECTED
}

// ---------------------------------------------------------------------------
// Application settings
// ---------------------------------------------------------------------------

/// Installation-wide configuration. Exactly one row, forever.
///
/// The single-row shape is enforced by the database rather than by convention:
/// the primary key defaults to `singleton` and a check constraint refuses any
/// other value, so a second settings row is not something a future writer can
/// create by accident. That matters because "the application currency" has to
/// have one answer — a table that quietly grew a second row would give two,
/// and whichever one a query happened to read first would win.
///
/// Read through `getCurrency()` in src/server/settings.ts, which falls back to
/// the default when the row is missing. It can legitimately be missing: a fresh
/// database before the migration's insert, and a test that has just truncated
/// everything. Neither should take a page down, so the loader defaults rather
/// than throwing.
model AppSetting {
  /// Always `singleton`, and constrained to it. Not an autoincrement and not a
  /// cuid: a settings row that could have any id is a settings *table*.
  id String @id @default("singleton")

  /// What the installation accounts in.
  ///
  /// **This is a label, not a rate.** Changing it re-denominates nothing: every
  /// `Decimal(12, 2)` in this schema keeps the exact value it had, and the
  /// currency says how those values should be read. There is no exchange rate
  /// anywhere in this system and none may be added — converting historical
  /// amounts would write numbers nobody transacted, and once written they are
  /// indistinguishable from the real ones.
  ///
  /// The accepted consequence is that history is re-labelled: a purchase
  /// entered while the setting said USD renders with a rupee sign after a
  /// switch to INR. The admin UI states this before it saves.
  currency Currency @default(INR)

  updatedAt DateTime @updatedAt @map("updated_at")

  /// Who last changed it. SetNull rather than cascade — the setting outlives
  /// the account that set it, and losing the attribution is better than losing
  /// the row.
  updatedBy     String? @map("updated_by")
  updatedByUser User?   @relation("AppSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

/// An operator of the system.
///
/// Clerk owns authentication — the password, MFA, the session — and this row
/// owns the local business identity: what the person is allowed to do here, and
/// something for foreign keys to point at. There is deliberately no password
/// column; if one existed it would be a second, unused credential store.
///
/// `clerkId` is the join between the two and the only stable identity key.
/// Email is *not* usable for that: it is unique here, but a user can change it
/// in Clerk at any time, which would silently strand the mapping.
model User {
  id String @id @default(cuid())

  /// Clerk's user id (`user_...`). Rows created before their Clerk account
  /// exists — the seed's, for instance — carry an `unlinked_` placeholder
  /// instead, which the first sign-in with a matching email claims. See
  /// `resolveUser` in src/server/auth.ts.
  clerkId String @unique @map("clerk_id")

  name  String
  email String @unique

  /// Authorisation lives here, not in Clerk. Clerk answers "who is this?";
  /// this column answers "what may they do in the inventory app?".
  role UserRole @default(STAFF)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockTransactions StockTransaction[]
  certificates      Certificate[]
  ordersCreated     Order[]            @relation("OrderCreatedBy")
  purchasesCreated  Purchase[]         @relation("PurchaseCreatedBy")
  stockLots         StockLot[]
  returnsCreated    Return[]           @relation("ReturnCreatedBy")
  lotsStatusChanged StockLot[]         @relation("LotStatusChangedBy")
  appSettingsSet    AppSetting[]       @relation("AppSettingUpdatedBy")

  @@index([role])
  @@map("users")
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  address String?

  /// Optional, because a walk-in buyer may not give one — but unique when
  /// present, so the same address cannot end up on two records. Postgres allows
  /// any number of NULLs in a unique index, which is exactly the behaviour
  /// wanted: many customers without an email, never two sharing one.
  email String? @unique

  /// ACTIVE customers can have new orders raised for them; INACTIVE ones are
  /// archived and no longer offered in the order builder. Their existing
  /// orders are untouched and still display them — archiving takes a customer
  /// out of circulation, it does not rewrite what they already bought.
  status CustomerStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([name])
  @@index([status])
  @@map("customers")
}

/// Somebody we buy from.
///
/// A supplier is referenced by two things, and the difference between them is
/// the whole of this model's design:
///
///   `products`  — where a catalogue item is normally sourced. Optional and
///                 `SetNull`: a product can exist before its supplier is known,
///                 and losing the supplier must not lose the product.
///   `purchases` — what was actually bought. Required and `Restrict`: a
///                 purchase is a document that has to keep saying who it was
///                 placed with, so the database refuses to let that become
///                 unanswerable.
///
/// That second relation is now load-bearing for costing as well as for
/// paperwork. `StockLot.sourceId` points at the purchase that brought a batch
/// in, so the chain from a unit on the shelf back to what was paid for it and
/// who supplied it runs `StockLot → Purchase → Supplier`. The middle link is
/// polymorphic rather than a foreign key, so it holds only because purchases
/// are never deleted — see the note on StockLot. The last link is guarded by
/// `Restrict`, and that guard is why a supplier with any purchase history
/// cannot be removed no matter what the application does.
model Supplier {
  id            String  @id @default(cuid())
  name          String
  contactPerson String? @map("contact_person")
  phone         String?
  email         String? @unique
  address       String?

  /// Our account with them — the reference *they* file us under, printed on
  /// their invoices. Free text, because vendor numbering is theirs to decide.
  accountNumber String? @map("account_number")

  /// How long an order from this supplier usually takes to arrive, in days.
  ///
  /// A planning figure an operator types, not something measured from the
  /// purchase history — that would be a different and much more careful
  /// calculation, and this is the number someone wants when deciding when to
  /// buy. It describes a supplier's turnaround, not a stock threshold, and
  /// nothing derives a reorder point from it. The unit is in the name so an
  /// integer cannot be read as weeks by the next person.
  typicalLeadTimeDays Int? @map("typical_lead_time_days")

  /// ACTIVE suppliers can be assigned to products and raised purchases against;
  /// INACTIVE ones are archived and offered in neither picker. Their existing
  /// products and purchases are untouched and still name them — archiving takes
  /// a supplier out of circulation, it does not rewrite what was already bought
  /// from them, and it never touches a stock lot or an acquisition cost.
  status SupplierStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products  Product[]
  purchases Purchase[]

  @@index([name])
  @@index([status])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Product {
  id          String  @id @default(cuid())
  name        String
  sku         String  @unique
  description String?

  /// A plain label rather than a lookup table: categories here are a filter in
  /// the UI, not something that owns behaviour or rows of its own.
  category String

  /// There is deliberately no product-level cost column here.
  ///
  /// One stood in this position — `costPrice`, then `standardCost` — and it was
  /// removed rather than repaired. Every version of it was a single number
  /// claiming to describe what a shelf of mixed deliveries cost, and the
  /// business it describes buys the same part at ₹8,000, then ₹9,500, then
  /// ₹11,000. No column on the catalogue row can hold that, so the column could
  /// only ever be one of three things: stale, absent, or wrong. Being all three
  /// silently is what made it dangerous — a plausible figure sitting where a
  /// real cost belongs is indistinguishable from a real cost to every reader
  /// that follows.
  ///
  /// Actual acquisition cost lives on `StockLot.unitCost`, one row per receipt,
  /// frozen at the moment the goods arrived, and is carried onto
  /// `StockLotConsumption` when a sale draws on it. That is the only cost this
  /// system recognises, and it is what valuation, COGS and margin all read.
  ///
  /// Do not reintroduce this field under another name. `lastPurchaseCost` and
  /// `averageCost` are the same mistake with better manners: both would be a
  /// derived number cached on a row that has no business deciding it, and both
  /// would drift the moment the next delivery lands. Where a purchase line
  /// wants a helpful starting figure, it is read at query time from the most
  /// recent PURCHASE lot and labelled as what it is — what was last paid, and
  /// when. See `lastPaidByProduct` in src/server/purchases.ts.

  /// A reference price, and nothing more.
  ///
  /// This is **not** what any order sold for. The same part is quoted at
  /// different prices to different customers — ₹12,000 to one, ₹13,500 to
  /// another — so no single column on the catalogue row can describe what was
  /// actually charged. This one prefills a new order line, and the salesperson
  /// accepts it or types over it.
  ///
  /// The actual price lives on `OrderItem.unitPrice`, frozen at the moment the
  /// line was quoted. Changing this field must never alter an order that
  /// already exists; if you are reaching for it to compute historical revenue,
  /// margin, or customer value, you want the order line instead.
  ///
  /// Nullable, and for a reason the removed cost column shares: a part that is
  /// only ever quoted has no list price, and requiring one would manufacture a
  /// number nobody stands behind.
  sellingPrice Decimal? @map("selling_price") @db.Decimal(12, 2)

  /// Stock on hand. Never write this directly — go through the stock engine so
  /// a StockTransaction is recorded in the same database transaction.
  ///
  /// A physical count and nothing more. It is deliberately not classified: this
  /// model carried a `minimumStock` companion, and a derived low/out-of-stock
  /// status over the pair, until both were removed. The business does not work
  /// to fixed stock thresholds, so the threshold turned a quantity into an
  /// alert nobody had asked for. Zero here means zero units, not a status.
  stockQuantity Int @default(0) @map("stock_quantity")

  status    ProductStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  /// Optional: a product can exist before its supplier is known, and removing
  /// a supplier must not remove the catalogue items bought from them.
  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  orderItems        OrderItem[]
  purchaseItems     PurchaseItem[]
  stockTransactions StockTransaction[]
  certificates      Certificate[]
  stockLots         StockLot[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([supplierId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")
  status      OrderStatus @default(DRAFT)

  /// Sum of the line totals. Denormalised so lists and reports do not
  /// aggregate items on every read; recalculated whenever the items change.
  ///
  /// `total = subtotal`, enforced by a check constraint in the migration.
  ///
  /// Two columns holding one number is the duplication this schema otherwise
  /// argues against — see the note on `OrderItem.fulfilledQuantity` about two
  /// stored numbers that must agree eventually disagreeing. It is kept
  /// deliberately anyway: `total` is what every list, report, dashboard and
  /// export reads, so collapsing the pair would touch far more code than it
  /// would simplify. The check constraint is what makes the redundancy safe —
  /// the database arbitrates the agreement rather than trusting whatever
  /// writes an order.
  ///
  /// There is no tax column and no discount column, and neither is a gap. This
  /// system does not compute tax, and the discount feature was removed outright
  /// (§20) rather than left defaulting to zero. A zero column is not neutral:
  /// it is a field the UI will eventually render and a value a report will
  /// eventually sum. Nothing can read a column that is not there.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// When the order reached each terminal-ish state.
  ///
  /// `confirmedAt` is the moment stock was deducted, which makes it the one
  /// worth having: the status alone says an order *is* confirmed, and these say
  /// when it became so. They are written by the engine, never by a client, and
  /// exist for display and for reading an order's life back afterwards — the
  /// stock ledger, not these columns, is what decides whether inventory moved.
  confirmedAt DateTime? @map("confirmed_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  /// Required: an order without a customer is not a state this app has a use
  /// for. Restrict, so a customer with history cannot be deleted — deactivate
  /// them instead.
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Who raised the order, resolved from the Clerk session on the server. Null
  /// for seeded rows, and nulled rather than cascaded if the user is later
  /// removed — the order still happened.
  createdBy     String? @map("created_by")
  createdByUser User?   @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  items OrderItem[]

  /// Goods sent back against this order. Any number over its life, each one a
  /// separate physical receipt — see `Return`.
  returns Return[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  quantity Int

  /// What this customer was quoted for one unit, on this order.
  ///
  /// The authoritative selling price and the only one any revenue figure may
  /// read. It defaults from `Product.sellingPrice` when the line is added and
  /// is then a fact about this order alone — editing the catalogue afterwards
  /// does not reach it, and neither does confirming, fulfilling or cancelling.
  ///
  /// Set while the order is a draft; immutable from confirmation onward,
  /// because `isEditable` permits edits in no other status.
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  /// What these units cost us, frozen when the order was confirmed and the
  /// stock actually left. The mirror of `unitPrice` on the cost side, and
  /// deliberately a *total* rather than a unit rate: the units on one line can
  /// come from several lots at several prices, and a single per-unit figure
  /// derived from a mixed allocation is a number that reads as authoritative
  /// while being true of nothing. Per-lot rates live on StockLotConsumption.
  ///
  /// Null until the order is confirmed, and null again if it is cancelled —
  /// stock that came back was never sold.
  costTotal Decimal? @map("cost_total") @db.Decimal(12, 2)

  /// How many of `quantity` the cost above actually covers.
  ///
  /// This is the field that keeps a partially-costed sale honest. Stock
  /// received before this system existed has no known acquisition cost, and
  /// FIFO will happily consume it: selling 15 units where only 10 came from a
  /// costed lot leaves `costTotal` describing 10 of them. Reporting that total
  /// as though it covered all 15 would understate cost and overstate profit,
  /// so the coverage travels with the number and every margin figure is
  /// obliged to carry it.
  ///
  /// Zero exactly when `costTotal` is null.
  ///
  /// Counted against `fulfilledQuantity`, never against `quantity`: a unit that
  /// has not shipped has no acquisition cost to know, so including it here
  /// would report a fulfilment gap as a costing gap. See the note below.
  costedQuantity Int @default(0) @map("costed_quantity")

  /// How many of `quantity` have physically left the building.
  ///
  /// The stock counterpart of `costedQuantity`. That field answers how much of
  /// this line the *money* describes; this one answers how much of it the
  /// *stock* describes — and the two questions came apart the moment an order
  /// was allowed to be confirmed against a shelf that could not fill it.
  ///
  /// The business sells parts it does not yet hold. Confirmation therefore
  /// deducts what is on hand and records the rest as an obligation: an order
  /// for 5 against 3 units confirms with `fulfilledQuantity = 3`, the ledger
  /// carries one STOCK_OUT for those 3, and the remaining 2 have **no**
  /// StockTransaction, no lot, no consumption row and no cost. They are not
  /// negative inventory and not a phantom batch; they are simply two units
  /// nobody has shipped yet. `Product.stockQuantity` never goes below zero and
  /// the valuation layer never learns they exist.
  ///
  /// The remainder is cleared later by an explicit operator action once stock
  /// arrives — see `fulfilOrder` in src/server/orders.ts. Nothing allocates a
  /// delivery to an order automatically, because choosing which of three
  /// waiting orders gets a short delivery is a decision this system has no
  /// grounds to make.
  ///
  /// Three quantities, and keeping them apart is the whole point:
  ///
  ///     costedQuantity                        shipped, cost known
  ///     fulfilledQuantity - costedQuantity    shipped, cost unknown
  ///     quantity - fulfilledQuantity          never shipped, no cost exists
  ///
  /// `0 <= costedQuantity <= fulfilledQuantity <= quantity` is enforced by
  /// check constraints in the migration, which Prisma's schema language cannot
  /// express.
  ///
  /// The outstanding quantity is deliberately **not** a column. It is
  /// `quantity - fulfilledQuantity`, and two stored numbers that must agree are
  /// two numbers that will eventually disagree.
  fulfilledQuantity Int @default(0) @map("fulfilled_quantity")

  /// How many shipped units the customer has sent back.
  ///
  /// A fourth quantity, and it does not disturb the three above.
  /// `fulfilledQuantity` is deliberately **not** decremented by a return: it
  /// records a physical event that genuinely happened, and reducing it would
  /// contradict a shipment the ledger still carries. It would also drag
  /// `costedQuantity` down to preserve `costedQuantity <= fulfilledQuantity`,
  /// which would report a return as a *costing* gap — the confidently wrong
  /// number src/lib/cost-coverage.ts exists to prevent.
  ///
  ///     costedQuantity                        shipped, cost known
  ///     fulfilledQuantity - costedQuantity    shipped, cost unknown
  ///     quantity - fulfilledQuantity          never shipped, no cost exists
  ///     returnedQuantity                      shipped, then came back
  ///
  /// Units still with the customer are `fulfilledQuantity - returnedQuantity`,
  /// and are deliberately not a column for the same reason the outstanding
  /// quantity is not one.
  ///
  /// `0 <= returnedQuantity <= fulfilledQuantity` is enforced by a check
  /// constraint in the migration, which is what makes over-return and repeated
  /// return of the same units unrepresentable rather than merely refused by a
  /// code path. It is derivable by summing the return lots that name this line,
  /// and is stored anyway because a row-level check cannot read an aggregate —
  /// the same justification `costedQuantity` carries.
  returnedQuantity Int @default(0) @map("returned_quantity")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// The batches created by returns against this line. One per cost layer.
  returnedLots StockLot[] @relation("ReturnedFromOrderItem")

  /// Photographs attached to this line. Any number, including none.
  images OrderItemImage[]

  /// Deliveries expected to cover this line's outstanding units. Advisory.
  supplyLinks SupplyLink[]

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One line per product per order. Two lines for the same product are an
  /// editing mistake, not a scenario — the quantity belongs on one line.
  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// A photograph attached to one order line — a packing shot, a picture of
/// damage, the state of the goods as they went out.
///
/// **Attached to the line, not the order.** A photograph is nearly always *of a
/// part*, and an order carrying five lines would otherwise leave somebody
/// guessing which one a picture referred to. The line is the smallest thing the
/// photograph is actually about.
///
/// **Deliberately not the certificate system.** A certificate is a controlled
/// airworthiness document: it belongs to a batch, carries issue and expiry
/// dates, is superseded rather than deleted, and drives a compliance register.
/// An order-line photograph has no lifecycle, no expiry, and no bearing on
/// whether anything may be sold. Merging them would give an informal snapshot a
/// compliance meaning it must never carry.
///
/// **The bytes live here, as `bytea`.** Certificates go to a `FileStorage`
/// driver because they are controlled documents an operator may want in object
/// storage. These do not: an order and its photographs are then one thing to
/// back up, one thing to restore and one thing to delete, with no second system
/// that can drift out of step or leave orphaned bytes behind.
///
/// **Only on a committed order.** `updateOrder` replaces an editable order's
/// lines wholesale — a `deleteMany` followed by a `create` — so a line on a
/// DRAFT or PENDING order has no stable identity across an edit. Attaching a
/// photograph to one would mean the cascade below silently destroyed it the
/// next time anybody changed a quantity. The server therefore accepts images
/// only while the order is CONFIRMED or COMPLETED, which is exactly
/// `canFulfilOutstanding` and exactly the complement of `isEditable`. Keeping
/// the two disjoint is what makes the cascade safe rather than dangerous, and
/// is why `updateOrder` needed no change at all.
model OrderItemImage {
  id String @id @default(cuid())

  /// Cascade, matching `OrderItem` itself: an attachment cannot outlive the
  /// line it belongs to. Safe precisely because of the status rule above — no
  /// image can exist on a line that `updateOrder` is able to replace.
  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// The image itself. The only copy: nothing mirrors these bytes onto the
  /// line, and no URL is stored as a rival source of truth.
  data Bytes

  /// The name the file had when it was uploaded. Shown to people, and used for
  /// nothing else — never to build a path, never to decide a content type.
  fileName String @map("file_name")

  /// Determined by reading the file's leading bytes on upload, never taken from
  /// the browser's claim. It is what the download route sends back, so a wrong
  /// value here would be a way to have a file served as something it is not. A
  /// check constraint pins it to the four formats this feature accepts.
  contentType String @map("content_type")

  /// Bytes. Displayed, and bounded by a check constraint so a row cannot claim
  /// a size the upload rules would have refused.
  fileSize Int @map("file_size")

  createdAt DateTime @default(now()) @map("created_at")

  /// The line's gallery, oldest first — the only way these are ever read.
  @@index([orderItemId, createdAt])
  @@map("order_item_images")
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique @map("purchase_number")
  status         PurchaseStatus @default(DRAFT)

  total Decimal @default(0) @db.Decimal(12, 2)

  /// When the order was placed with the supplier, which is not necessarily
  /// when the row was created.
  purchaseDate DateTime @default(now()) @map("purchase_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// When the goods arrived, and when the purchase was called off. `receivedAt`
  /// is the moment stock was added. Like the order timestamps, these are for
  /// display and for reading a purchase's life back — the stock ledger, not
  /// these columns, is what decides whether inventory actually moved.
  receivedAt  DateTime? @map("received_at")
  cancelledAt DateTime? @map("cancelled_at")

  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Who raised the purchase, resolved from the Clerk session on the server.
  /// Null for seeded rows, and nulled rather than cascaded if the user is later
  /// removed — the purchase still happened.
  createdBy     String? @map("created_by")
  createdByUser User?   @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  items PurchaseItem[]

  @@index([status])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([createdBy])
  @@map("purchases")
}

model PurchaseItem {
  id String @id @default(cuid())

  quantity Int

  /// Copied from the product at the time of purchase, for the same reason
  /// OrderItem copies the price.
  unitCost Decimal @map("unit_cost") @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  purchaseId String   @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Order lines this delivery is expected to cover. Advisory.
  supplyLinks SupplyLink[]

  @@unique([purchaseId, productId])
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ---------------------------------------------------------------------------
// Supply expectation
// ---------------------------------------------------------------------------

/// Which delivery is expected to clear which outstanding order line.
///
/// The business sells parts it does not yet hold, so a confirmed order can owe
/// units nobody has shipped (see `OrderItem.fulfilledQuantity`). Those units
/// have no stock movement, no lot and no consumption row — deliberately, since
/// nothing has moved — which means the ledger cannot say which purchase will
/// cover them. This table is the only place that question has an answer.
///
/// **It is an expectation, and nothing else.** It creates no stock, consumes
/// none, costs nothing, touches no lot and fulfils no order. Receiving a
/// purchase that carries links still fulfils nothing: which of several waiting
/// orders gets a short delivery is a commercial decision, and settling it by
/// whoever's page refreshed first would bury that decision in a race.
/// `fulfilOrder` remains the only route from outstanding to shipped.
///
/// **Line to line, not document to document.** Outstanding quantity is a
/// property of an `OrderItem`, and a delivery covering one line of a three-line
/// order has to be able to say so. Many-to-many in both directions: one late
/// line is routinely covered by two consecutive deliveries, and one bulk
/// purchase line by several waiting orders.
///
/// **The quantity is what makes it useful.** Without it, three orders pointing
/// at one ten-unit purchase line say only that they are all waiting on it, not
/// whether it covers them.
///
/// Deliberately *not* modelled here: no status column and no history. A link
/// that no longer applies is deleted — by a cancellation, or by an operator —
/// and a lifecycle for expectations would be a second document nobody asked
/// for. Nothing in this table is a financial record.
model SupplyLink {
  id String @id @default(cuid())

  /// How many units of the purchase line are earmarked for the order line.
  ///
  /// Bounded from both sides, and neither bound can be a row-level check
  /// because both are aggregates: the links against one order line may not
  /// exceed that line's outstanding quantity, and the links against one
  /// purchase line may not exceed what that line ordered. `supply_links.ts`
  /// enforces both under row locks, which is the same shape `costedQuantity`
  /// and `returnedQuantity` use for the same reason.
  ///
  /// `quantity > 0` *is* a check constraint — that one is row-local.
  quantity Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Cascade on both sides: a link cannot outlive either line it joins, and
  /// deleting a line it points at leaves nothing for it to mean. This follows
  /// the schema's ownership rule for line items rather than inventing one.
  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  purchaseItemId String       @map("purchase_item_id")
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// One link per pair. A second row for the same two lines would be a second
  /// place to record the same expectation; the quantity belongs on one row.
  @@unique([orderItemId, purchaseItemId])
  @@index([orderItemId])
  @@index([purchaseItemId])
  @@map("supply_links")
}

// ---------------------------------------------------------------------------
// Stock ledger
// ---------------------------------------------------------------------------

/// One row per change to a product quantity — the audit trail behind every
/// stock adjustment. `quantity` is the absolute size of the move; the direction
/// is carried by `type`. `previousStock` and `newStock` record both sides of
/// the change, so a historical balance can be read back without replaying the
/// whole ledger, and a broken chain is visible at a glance.
///
/// The table is append-only: a mistake is corrected with a REVERSAL row that
/// references the transaction it undoes, never by editing or deleting history.
model StockTransaction {
  id            String               @id @default(cuid())
  type          StockTransactionType
  quantity      Int
  previousStock Int                  @map("previous_stock")
  newStock      Int                  @map("new_stock")

  /// Polymorphic pointer at whatever caused the move. Not a foreign key — see
  /// StockReferenceType. `referenceId` is null exactly when the type is MANUAL.
  referenceType StockReferenceType @default(MANUAL) @map("reference_type")
  referenceId   String?            @map("reference_id")

  /// Why the move happened, in the operator's words. Mandatory for a manual
  /// ADJUSTMENT — a correction with no stated reason is the one entry in this
  /// ledger nobody can audit — and left null for movements a document already
  /// explains. The requirement is enforced in `recordStockMovement` rather than
  /// as a check constraint, so the message can name the field.
  note String?

  createdAt DateTime @default(now()) @map("created_at")

  /// Restrict: a product that has moved stock has history, and history is not
  /// something a delete should take with it. Retire the product instead.
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Who triggered it. Null for system-generated rows such as the seed, and
  /// nulled rather than cascaded if the user is later removed — the movement
  /// still happened.
  createdBy     String? @map("created_by")
  createdByUser User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// The lot this movement brought into existence, if it was an inflow. The
  /// valuation layer hangs off the ledger and never the other way round.
  originatedLot StockLot? @relation("LotOrigin")

  /// The lots this movement drew from, if it was an outflow.
  lotConsumptions StockLotConsumption[] @relation("LotConsumption")

  @@index([productId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("stock_transactions")
}

// ---------------------------------------------------------------------------
// Valuation
// ---------------------------------------------------------------------------

/// A costed batch of stock: units that arrived together, at one price.
///
/// **This is not a second inventory system, and the distinction is the whole
/// design.** `Product.stockQuantity` remains the only answer to "how many do we
/// have", and `StockTransaction` remains the only record of what moved. Nothing
/// consults lots to decide whether a movement is legal, and no lot can exist
/// describing a movement the ledger does not already contain — every lot is
/// created by exactly one STOCK_IN row, which is what the unique constraint on
/// `stockTransactionId` enforces. Lots are a valuation and provenance index
/// laid over the ledger, not a parallel count of the shelf.
///
/// What they buy is the thing a single column on Product cannot express: the
/// same part bought at ₹8,000, then ₹9,500, then ₹7,800 is three lots, each
/// remembering what it actually cost, so a sale can be costed against the units
/// it actually consumed and historical margin stays fixed when the next
/// delivery lands at a fourth price.
///
/// One lot per receipt line, always — never merged with an existing lot even
/// when the product and unit cost match exactly. Two deliveries are two
/// batches with two sets of paperwork, and collapsing them would destroy the
/// distinction the moment somebody needs to know which certificate covers the
/// units on the shelf. See the note on `Certificate` about where that is going.
model StockLot {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// What one unit in this batch cost, frozen at receipt and never recomputed.
  ///
  /// Null means the cost is genuinely unknown — not zero, not "to be decided",
  /// and emphatically not something to fill in from the catalogue row — which
  /// is now incapable of offering one, and deliberately so. Stock that predates
  /// this system has no provable acquisition cost, and a null that survives all
  /// the way to the screen ("5 units of unknown cost") is worth more than a
  /// plausible number nobody can source.
  unitCost   Decimal?      @map("unit_cost") @db.Decimal(12, 2)

  /// Where the cost came from, and — through check constraints the migrations
  /// add, because Prisma's schema language cannot express them — a claim about
  /// whether `unitCost` is present:
  ///
  ///     PURCHASE   => unit_cost IS NOT NULL   (a supplier invoice line)
  ///     OPENING    => unit_cost IS NOT NULL   (an operator said what it cost)
  ///     ADJUSTMENT => unit_cost IS NOT NULL   (an operator said what it cost)
  ///     UNKNOWN    => unit_cost IS NULL       (nobody could say)
  ///
  /// The three inbound routes each pair a declared basis with a recorded cost;
  /// UNKNOWN is the one value that carries no cost, and it must carry none, so
  /// "we do not know" can never be stored as a number. That pairing is the
  /// whole costing model in four lines, and it is enforced by the database
  /// rather than only by the forms, because a lot written by a script, a fixture
  /// or a future migration is subject to the same rule as one written by an
  /// operator.
  ///
  /// An UNKNOWN lot created by an operator also carries their reason — in the
  /// note on its originating StockTransaction, which is the only place an
  /// explanation can outlive the form that collected it.
  costSource LotCostSource @map("cost_source")

  /// How many units arrived. Immutable once written.
  quantityReceived Int @map("quantity_received")

  /// How many are left. The only mutable column in the valuation layer, and it
  /// only ever moves under the product row lock its lot belongs to — see
  /// `allocateFifo` in src/server/stock.ts. Summed across a product's lots this
  /// must equal `Product.stockQuantity`; that invariant is what makes this an
  /// index over the ledger rather than a rival to it.
  quantityRemaining Int @map("quantity_remaining")

  /// What put these units on the shelf. Same polymorphic pair the ledger uses,
  /// and null exactly when the type is MANUAL.
  ///
  /// A customer return is SALES_RETURN with the Return's id, which is how a
  /// return lot is found — the same shape purchase lots use, and the reason
  /// there is no separate `returnId` foreign key here. Two representations of
  /// one fact is the duplication this schema argues against elsewhere.
  sourceType StockReferenceType @map("source_type")
  sourceId   String?            @map("source_id")

  /// Whether this batch may be sold. See `LotStatus`.
  ///
  /// Every existing lot is SALEABLE, and every lot that is not a customer
  /// return is created SALEABLE. Only FIFO and the saleable-stock derivation
  /// read this; nothing about quantity, cost or valuation depends on it.
  status LotStatus @default(SALEABLE) @map("status")

  /// The order line these units were sold on, before they came back.
  ///
  /// Set only on a return lot, and the reason there is no ReturnLine table: a
  /// return's per-line quantity is `SUM(quantityReceived)` over the lots naming
  /// that line, so storing it again would be a second number to keep in step.
  ///
  /// Restrict, because a line with returned stock against it is history.
  orderItemId String?    @map("order_item_id")
  orderItem   OrderItem? @relation("ReturnedFromOrderItem", fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The batch these units originally shipped from.
  ///
  /// The lineage pointer, and the only link between a returned batch and where
  /// it came from. It reaches the original cost, the original certificate and —
  /// one hop further — the supplier, all as *history* rather than as claims
  /// about these units now. Nothing is copied across it: the return lot's own
  /// certificate slot starts empty, and its supplier is nobody, because a
  /// customer is not a source of supply.
  originLotId String?   @map("origin_lot_id")
  originLot   StockLot? @relation("LotLineage", fields: [originLotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  returnedAs  StockLot[] @relation("LotLineage")

  /// Who moved this lot out of quarantine, when, and what they found.
  ///
  /// Written together by a release or a rejection and never afterwards — a
  /// second release attempt reports the lot already settled rather than
  /// overwriting the first inspector's name. Null on every lot that was never
  /// quarantined, which is every lot that is not a customer return.
  ///
  /// `statusNote` is the inspection finding and is mandatory when the other two
  /// are set: it is the only durable record of why these units were judged
  /// saleable or scrapped, and it cannot be reconstructed later.
  statusChangedBy   String?   @map("status_changed_by")
  statusChangedUser User?     @relation("LotStatusChangedBy", fields: [statusChangedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  statusChangedAt   DateTime? @map("status_changed_at")
  statusNote        String?   @map("status_note")

  /// When the batch arrived — the FIFO sort key, and the reason it is stored
  /// rather than read from `createdAt`: a backfilled lot is created today but
  /// arrived long ago, and consuming it in creation order would be wrong.
  receivedAt DateTime @map("received_at")

  /// The STOCK_IN that created this lot. One lot per movement, enforced.
  ///
  /// Nullable for exactly one reason: stock that already existed when lot
  /// tracking was introduced has no originating movement to point at. The
  /// backfill migration could only have given those rows a transaction id by
  /// inventing ledger entries for movements that never happened, which would
  /// have corrupted the one table this application treats as the truth. So
  /// they carry null instead, and null means "created by the backfill" — it is
  /// not a state application code is ever allowed to write.
  stockTransactionId String?           @unique @map("stock_transaction_id")
  stockTransaction   StockTransaction? @relation("LotOrigin", fields: [stockTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Who booked it in. Null for backfilled and seeded rows, and nulled rather
  /// than cascaded if the user is later removed — the delivery still happened.
  createdBy     String? @map("created_by")
  createdByUser User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  consumptions StockLotConsumption[]

  /// The airworthiness paperwork filed against this batch. A lot may have any
  /// number over time and at most one current — the same supersession
  /// mechanism certificates have always used, re-keyed from the product to the
  /// batch, because paperwork covers the units that arrived rather than the
  /// catalogue entry they were booked against.
  certificates Certificate[]

  /// The target of the composite foreign key on `certificates`, which is what
  /// stops a certificate naming one product while its lot names another.
  /// Redundant on its own — `id` is already unique — and present only so the
  /// pair can be referenced.
  @@unique([id, productId])
  /// The FIFO scan: a product's open lots, oldest first. `id` breaks ties so
  /// the order is total — two lots received in the same millisecond must still
  /// be consumed in a deterministic sequence, or two concurrent orders could
  /// disagree about which came first.
  @@index([productId, receivedAt, id])
  /// Finding the lots a purchase created, for the cancellation guard. Also
  /// finding the lots a return created, which uses the same pair.
  @@index([sourceType, sourceId])
  /// How much of an order line has come back, and in which batches.
  @@index([orderItemId])
  /// Walking lineage from a source batch to what was returned out of it.
  @@index([originLotId])
  @@index([statusChangedBy])
  /// The FIFO scan and the quarantine queue are served by partial indexes on
  /// `status`, which Prisma's schema language cannot express — they live in the
  /// migration SQL beside the check constraints.
  @@map("stock_lots")
}

/// One draw against one lot: which batch a movement's units came out of, and
/// what they cost.
///
/// Append-only, like the ledger it hangs off. A return is a new row with a
/// negative quantity, never an edit or a delete of the row it undoes — so a
/// lot's history reads as what happened rather than as what someone last
/// decided it should look like, and `quantityRemaining` is always reachable as
/// `quantityReceived` minus the sum of these.
model StockLotConsumption {
  id String @id @default(cuid())

  lotId String   @map("lot_id")
  lot   StockLot @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The STOCK_OUT that drew these units, or the REVERSAL that put them back.
  stockTransactionId String           @map("stock_transaction_id")
  stockTransaction   StockTransaction @relation("LotConsumption", fields: [stockTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Signed: positive takes units out of the lot, negative returns them.
  quantity Int

  /// Copied from the lot at the moment of the draw, not read through the
  /// relation afterwards. The lot's cost cannot change today, but freezing it
  /// here means historical COGS stays a fact about this row rather than a
  /// lookup that a future migration could quietly restate.
  ///
  /// Null when the lot's cost is unknown, which is how an uncosted sale stays
  /// visibly uncosted all the way to the report.
  unitCost  Decimal? @map("unit_cost") @db.Decimal(12, 2)
  /// `quantity * unitCost`, and signed with it, so a plain SUM over these rows
  /// nets returns against draws without the caller remembering to.
  totalCost Decimal? @map("total_cost") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([stockTransactionId])
  @@index([lotId])
  @@map("stock_lot_consumptions")
}

// ---------------------------------------------------------------------------
// Sales returns
// ---------------------------------------------------------------------------

/// Goods a customer received and sent back.
///
/// **A return is not a cancellation, and the distinction is the whole reason
/// this table exists.** A cancellation says the sale never happened: the units
/// never really left, so they go back into the batches they came from at the
/// prices those batches cost, and the order's revenue and cost are erased. A
/// return says the sale did happen and is being partly unwound: the units left,
/// spent time in somebody else's custody, and have come back as a new physical
/// receipt whose airworthiness is no longer self-evident.
///
/// Returned units therefore never re-enter their original lot. They arrive as
/// new StockLots — one per original cost layer, so a shipment drawn from two
/// batches at two prices comes back as two batches at those same two prices,
/// never one at the average. Each is QUARANTINED until somebody inspects it,
/// carries no certificate until somebody files one, and is dated by the day it
/// arrived rather than the day the original batch did.
///
/// This row is the receipt event: what came back, when, and who booked it in.
/// There is deliberately no ReturnLine table — a return's per-line quantity is
/// the sum of the lots naming that line, and a stored copy would be a second
/// number to keep in step. See `StockLot.orderItemId`.
///
/// Revenue is untouched here. `OrderItem.quantity`, `unitPrice`, `total` and
/// `costTotal` all keep describing the sale that was made; a return is
/// presented as its own economic event and netted in reporting, so gross sales,
/// returns and net sales are three readable figures rather than one restated
/// one.
model Return {
  id String @id @default(cuid())

  /// Human reference, in the same shape as `Order.orderNumber`.
  returnNumber String @unique @map("return_number")

  /// When the goods physically arrived back.
  ///
  /// Distinct from `createdAt`, which is when somebody typed it in. This is the
  /// economic event, and it becomes the `receivedAt` of every lot this return
  /// creates — so returned stock sits in FIFO where it actually re-entered the
  /// building, behind anything received while it was away.
  receivedAt DateTime @map("received_at")

  /// Why the customer sent them back, in their words. The only durable record
  /// of the reason, and it cannot be reconstructed afterwards.
  note String?

  createdAt DateTime @default(now()) @map("created_at")

  /// The sale being partly unwound. Restrict: an order with returned goods
  /// against it is history, and history is not something a delete should take.
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Who booked it in, resolved from the Clerk session on the server. Nulled
  /// rather than cascaded if the user is later removed — the goods still came
  /// back.
  createdBy     String? @map("created_by")
  createdByUser User?   @relation("ReturnCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([receivedAt])
  @@index([createdBy])
  @@map("returns")
}

// ---------------------------------------------------------------------------
// Certificates
// ---------------------------------------------------------------------------

/// Airworthiness and conformity paperwork for a part.
///
/// In an aviation parts business the certificate is not decoration — an
/// uncertified part is unsellable, and "which document, issued when, by whom"
/// is a question an auditor asks years later. The table is therefore shaped as
/// a record of documents over time rather than a column on Product.
///
/// A product has at most one *current* certificate and any number of retired
/// ones. `supersededAt` is what separates them: null means current, set means
/// replaced or withdrawn. Nothing is ever overwritten or deleted in the normal
/// course of events — replacing a certificate retires the old row and inserts a
/// new one, so the history reads as a sequence and the file each version
/// pointed at is still there.
///
/// "At most one current" is enforced by a partial unique index on
/// (product_id) WHERE superseded_at IS NULL, which Prisma's schema language
/// cannot express — it lives in the migration SQL alongside the check
/// constraints. Without it two concurrent uploads would both retire the old
/// certificate and both insert a new one, leaving a product with two current
/// certificates and no way to say which is authoritative.
///
/// **Known limitation, left deliberately unfixed for now.** A certificate is
/// attached to a *product*, but in reality paperwork covers the batch that
/// arrived, not the catalogue entry. Two deliveries of the same part number
/// under two different 8130-3 forms are indistinguishable here, and a product
/// whose current certificate is valid can still have older, differently
/// certified units sitting on the shelf.
///
/// StockLot is the batch, and is shaped so this becomes an additive change
/// rather than a redesign: a nullable `stockLotId` here, with product-level
/// certificates staying valid as the fallback for stock whose lot is unknown.
/// That is why lots are never merged even when product and unit cost match —
/// collapsing two receipts would destroy the very distinction that FK needs.
/// Not implemented in this change set; see HANDOVER.md.
model Certificate {
  id String @id @default(cuid())

  /// A plain label rather than an enum, for the same reason Product.category
  /// is: the set is open. FAA 8130-3, EASA Form 1, a Certificate of
  /// Conformity and an Airworthiness Certificate are the common ones, but a
  /// part sourced under a different authority — Transport Canada, CAAC, a
  /// manufacturer's own form — must not need a migration to record.
  certificateType String @map("certificate_type")

  /// The number printed on the document. Not unique: two authorities can
  /// legitimately issue the same number, and a reissued document often keeps
  /// the number it had.
  certificateNumber String @map("certificate_number")

  /// Dates, not timestamps — a certificate is issued on a day, not at an
  /// instant, and storing a time would invent a precision the paper does not
  /// have and drag timezone conversion into every comparison.
  issueDate DateTime @map("issue_date") @db.Date

  /// Nullable, and genuinely so. A Certificate of Conformity typically never
  /// expires; an airworthiness release usually does. Code that assumes an
  /// expiry date exists is wrong about half the documents in this table.
  expiryDate DateTime? @map("expiry_date") @db.Date

  /// The name the file had when it was uploaded. Shown to people, and used for
  /// nothing else — never to build a path, never to decide a content type.
  fileName String @map("file_name")

  /// Where the bytes actually live, as an opaque key the storage layer
  /// understands. Not a URL: a URL bakes in one provider and, worse, tends to
  /// become a public one. Certificates are served through an authenticated
  /// route that resolves this key server-side, so the location is never
  /// something a browser can guess or share.
  storageKey String @map("storage_key")

  /// Determined by inspecting the file's leading bytes on upload, not taken
  /// from the browser's claim. It is what the download route sends back, so a
  /// wrong value here would be a way to have a file served as something it is
  /// not.
  contentType String @map("content_type")

  /// Bytes. Displayed, and checked against the stored object as a cheap
  /// integrity signal.
  fileSize Int @map("file_size")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Null while this is the product's current certificate; set when it is
  /// replaced or withdrawn. This is the whole history mechanism.
  supersededAt DateTime? @map("superseded_at")

  /// Cascade, unlike most relations here. A certificate describes exactly one
  /// product and has no meaning without it, so it cannot outlive it — and the
  /// only products that can be deleted are ones that never traded. The stored
  /// file is removed explicitly by `deleteProduct`, because a foreign key
  /// cannot reach into a filesystem or a bucket.
  ///
  /// Kept alongside `stockLotId` rather than derived from it, for three
  /// reasons: legacy rows have no lot to derive it from; the delete path and
  /// the file cleanup both key on it; and holding both lets the database
  /// enforce that they agree, through a composite foreign key onto
  /// `stock_lots (id, product_id)` written by hand in the migration.
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// The batch this paperwork covers.
  ///
  /// **Nullable for history only.** Certificates filed before the model moved
  /// to lots have no batch to point at, and inventing one would fabricate
  /// coverage nobody can evidence — so they keep a null here and stay readable
  /// as the record of a document that was filed against a part. A check
  /// constraint requires every row with a null lot to be superseded, which
  /// makes "product-level certificates are history" a fact the database
  /// enforces rather than a convention the code remembers.
  ///
  /// Restrict, not Cascade: a lot is only ever deleted for a product that has
  /// never traded, and the delete path removes the certificates first so the
  /// files go with them. Cascading here would let a lot delete quietly destroy
  /// paperwork history.
  stockLotId String?   @map("stock_lot_id")
  stockLot   StockLot? @relation(fields: [stockLotId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade)

  /// Who uploaded it, resolved from the Clerk session on the server. Nulled
  /// rather than cascaded if the user is later removed — the upload still
  /// happened.
  uploadedBy     String? @map("uploaded_by")
  uploadedByUser User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, supersededAt])
  @@index([stockLotId, supersededAt])
  @@index([expiryDate])
  @@index([certificateType])
  @@index([uploadedBy])
  @@map("certificates")
}
