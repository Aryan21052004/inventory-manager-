# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored and is read by both Next.js and the Prisma CLI
# (see prisma.config.ts). Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Required.
# Local example:  postgresql://postgres:postgres@localhost:5432/inventory_manager?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_manager?schema=public"

# --- Authentication (Clerk) -------------------------------------------------
# Get both keys from https://dashboard.clerk.com → API Keys.
#
# Optional in development: with these blank the app runs in "setup mode" with
# authentication disabled, so the UI can be reviewed before an account exists.
# Required in production — the app refuses to start without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Where Clerk sends users. These defaults match the routes in this project.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Application ------------------------------------------------------------
# Shown in the sidebar, the page titles, and the browser tab.
NEXT_PUBLIC_APP_NAME="Inventory Manager"

# --- File storage (certificates) --------------------------------------------
# Where uploaded certificate files are kept.
#
# "local" writes to FILE_STORAGE_DIR on disk and is fine for development. The
# directory is deliberately outside /public: Next serves that folder statically
# with no session in the way, so anything in it is downloadable by anyone who
# learns the filename. Certificates are served instead through an authenticated
# route (/api/certificates/[id]/file).
#
# To move to S3, Supabase or Cloudinary later, implement one more FileStorage
# in src/server/storage/ and add it to the switch in src/server/storage/index.ts.
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_DIR=".storage"
