# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored and is read by both Next.js and the Prisma CLI
# (see prisma.config.ts). Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# The connection the running application uses. Required.
#
# On a pooled host this is the *pooled* string: every request the app serves
# goes through it, which is what the pooler exists to absorb. Locally there is
# only one database and one string, so it is also what migrations use.
#
# Local example:  postgresql://postgres:postgres@localhost:5432/inventory_manager?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_manager?schema=public"

# The connection the Prisma CLI uses for migrations and introspection. Optional.
#
# Leave it unset locally. prisma.config.ts falls back to DATABASE_URL, which is
# the same database, so nothing changes.
#
# Set it on a pooled host, where the two connections are genuinely different.
# Supabase gives you both strings in Project Settings -> Database:
#
#   DATABASE_URL  ->  Transaction pooler, port 6543   (the application)
#   DIRECT_URL    ->  Direct connection,  port 5432   (migrations)
#
# The pooler runs in transaction mode, which cannot carry DDL or the advisory
# lock `prisma migrate` takes, so `npm run db:deploy` against it will fail or
# behave unpredictably. That is the whole reason this variable exists.
#
# Append `?sslmode=require` to both — Supabase serves only over TLS.
#
# Never point the application at DIRECT_URL. Runtime traffic on the direct port
# exhausts the connection limit the pooler is there to protect, which is why
# this variable is deliberately absent from src/lib/env.ts: the app has no
# reason to read it, and nothing that cannot read it can misuse it.
DIRECT_URL=""

# --- Authentication (Clerk) -------------------------------------------------
# Get both keys from https://dashboard.clerk.com → API Keys.
#
# Optional in development: with these blank the app runs in "setup mode" with
# authentication disabled, so the UI can be reviewed before an account exists.
# Required in production — the app refuses to start without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Where Clerk sends users. These defaults match the routes in this project.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- Authentication (Supabase Auth) -----------------------------------------
# Public Supabase configuration, from Project Settings -> API.
#
# Both values are browser-safe and are meant to be public: the NEXT_PUBLIC_
# prefix compiles them into the client bundle, so anyone who loads the app can
# read them. That is expected. They identify the project; they grant nothing on
# their own.
#
# Both are required. The browser client and the server client are each built
# from this same pair, so a missing value fails sign-in outright rather than
# degrading it.
#
# NEXT_PUBLIC_SUPABASE_URL is the same project URL as SUPABASE_URL further
# down. Two names for one value is deliberate: the storage driver's copy is
# server-only and must stay unreadable from the browser, so it cannot double as
# the one the client reads. Set both to the same string.
#
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY takes the publishable key — the value
# Supabase labels `sb_publishable_*`, or the legacy `anon` JWT on a project still
# issuing those. Both are accepted by the installed @supabase/ssr and
# @supabase/supabase-js, and "publishable" is the name those packages' own
# documentation now uses.
#
# NO SECRET BELONGS IN EITHER VARIABLE. Never put SUPABASE_SERVICE_ROLE_KEY here.
# That key bypasses row-level security, and a NEXT_PUBLIC_ variable is published
# to every visitor, so it would hand every visitor unrestricted database access
# with nothing in the code able to detect it. The service-role key stays
# server-only: no NEXT_PUBLIC_ prefix, read only through src/lib/env.ts, and
# never referenced from a client component.
#
# What the publishable key is allowed to reach is decided by the database, not by
# this file. The Data API roles `anon` and `authenticated` hold no privilege on
# any table in `public`, and row-level security is enabled on all sixteen domain
# tables — see the 20261004120000_restrict_data_api_access migration — so this key
# grants sign-in and nothing else.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Application ------------------------------------------------------------
# Shown in the sidebar, the page titles, and the browser tab.
NEXT_PUBLIC_APP_NAME="Inventory Manager"

# --- File storage (certificates) --------------------------------------------
# Where uploaded certificate files are kept.
#
# "local" writes to FILE_STORAGE_DIR on disk and is fine for development. The
# directory is deliberately outside /public: Next serves that folder statically
# with no session in the way, so anything in it is downloadable by anyone who
# learns the filename. Certificates are served instead through an authenticated
# route (/api/certificates/[id]/file).
#
# "supabase" writes to a private Supabase Storage bucket and is the production
# driver. Use it anywhere the app runs as more than one process: a file written
# to one instance's local disk is unreadable from the next and gone at the
# following deploy, which for an airworthiness certificate loses the document
# without anything appearing to fail.
#
# To add a third (S3, Cloudinary), implement one more FileStorage in
# src/server/storage/ and add it to the switch in src/server/storage/index.ts.
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_DIR=".storage"

# --- Supabase Storage (only when FILE_STORAGE_DRIVER="supabase") ------------
# Required together. The app refuses to start when the driver is "supabase" and
# either is missing, rather than failing at the first upload in front of a user.
#
# THE BUCKET MUST BE PRIVATE. Nothing in the code can verify this, and a public
# bucket would make every certificate readable by anyone who learned its object
# path — with no error raised anywhere. Certificates are meant to be reachable
# only through the authenticated route, which reads the bytes server-side; the
# storage layer deliberately has no URL method and mints no signed links.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security and must never be given
# a NEXT_PUBLIC_ prefix or referenced from a client component — it is read only
# through src/lib/env.ts, which is server-only.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional. Defaults to "certificates".
SUPABASE_STORAGE_BUCKET="certificates"
